# ── DB ────────────────────────────────────────────────────────────────
# 로컬: docker compose up -d db 로 띄운 뒤 아래 그대로 쓰면 된다.
DATABASE_URL=postgresql://hellchang:hellchang@localhost:5434/hellchang
POSTGRES_PASSWORD=hellchang

# ── 인증 (Auth.js) ────────────────────────────────────────────────────
# AUTH_SECRET 은 `npx auth secret` 으로 생성한다.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# 카카오 개발자센터 > 내 애플리케이션 > 앱 키 / 보안
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── 2단계(식단 AI · 유산소 스크린샷)용 자리 ──────────────────────────
# 지금은 쓰지 않는다. 스펙 D/E 에서 채운다.
# OPENAI_API_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
